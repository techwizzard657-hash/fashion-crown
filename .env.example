# ============================================================
# Fashion Crown Kenya — Environment Variables (.env)
# Store these in your Supabase Dashboard:
# Project Settings -> Edge Functions -> Secrets
# ============================================================

# --- Payment Gateway Provider ---
# Options: 'daraja' (Direct Safaricom M-Pesa Till - 0% fee), 'paystack', or 'intasend'
PAYMENT_PROVIDER=daraja

# --- SAFARICOM DARAJA 2.0 DIRECT CONFIGURATION ---
# Register your Till at https://developer.safaricom.co.ke
# Environment: 'sandbox' for testing, 'production' for live payments
MPESA_ENV=sandbox

# From your Daraja App (My Apps -> View App):
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Your M-Pesa Buy Goods Till Number (Store Number) or Paybill:
MPESA_SHORTCODE=174379

# The Passkey from Daraja Portal (Simulate / Go Live section):
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Webhook Callback URL where Safaricom sends payment confirmations:
MPESA_CALLBACK_URL=https://your-project-ref.functions.supabase.co/mpesa-callback
MPESA_CALLBACK_SECRET=sec_fc_9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d

# --- SUPABASE CONFIGURATION ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- OPTIONAL: PAYSTACK FALLBACK ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxx
