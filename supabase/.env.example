# ============================================================
# Fashion Crown Kenya — Backend Environment Variables (.env)
# Store these in your Supabase Dashboard:
# Project Settings -> Edge Functions -> Secrets
# ============================================================

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- OPTION 1: INTASEND (RECOMMENDED) ---
# Zero business registration needed.
# Hides your personal name from voters completely.
# Payouts withdraw directly into your personal M-Pesa phone number.

# Set environment: 'sandbox' for testing, 'production' for real money
INTASEND_ENV=sandbox

# Your IntaSend API Keys (from Dashboard -> Settings -> API Keys):
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxx
INTASEND_SECRET_KEY=ISSecretKey_test_xxxxxx

# Webhook Challenge Token (Set in IntaSend Dashboard -> Settings -> Webhooks):
INTASEND_WEBHOOK_CHALLENGE=fc_secret_challenge_123456

# --- OPTION 2: DIRECT SAFARICOM DARAJA (OPTIONAL FALLBACK) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-project-ref.functions.supabase.co/mpesa-callback
MPESA_CALLBACK_SECRET=sec_fc_9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d

# --- Domains & CORS ---
CLOUDFLARE_PAGES_DOMAIN=fashioncrown.pages.dev
CUSTOM_DOMAIN=fashioncrown.co.ke
